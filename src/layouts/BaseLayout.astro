---
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false
} = Astro.props as Props;

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteOrigin = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteOrigin);
const pageTitle = title === SITE_TITLE || title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
const withBasePath = (value: string) => {
  if (/^https?:\/\//.test(value)) return value;
  const normalized = value.startsWith('/') ? value.slice(1) : value;
  return `${basePath}${normalized}`;
};
const ogImage = new URL(withBasePath(image ?? '/og/site.svg'), siteOrigin);
const ogImageAlt = imageAlt ?? `${pageTitle} 대표 이미지`;
const homeHref = basePath;
const privacyHref = `${basePath}privacy/`;
const rssHref = new URL(withBasePath('/rss.xml'), siteOrigin).href;
const websiteUrl = new URL(basePath, siteOrigin).href;
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';
const hasGa = gaMeasurementId.length > 0;

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.href,
        inLanguage: 'ko-KR',
        isPartOf: {
          '@type': 'Blog',
          name: SITE_TITLE,
          url: websiteUrl
        },
        author: author ? { '@type': 'Person', name: author } : undefined,
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          url: websiteUrl
        },
        keywords: tags.length > 0 ? tags.join(', ') : undefined,
        datePublished: publishedTime,
        dateModified: modifiedTime ?? publishedTime,
        mainEntityOfPage: canonical.href,
        image: ogImage.href
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: websiteUrl,
        inLanguage: 'ko-KR',
        potentialAction: {
          '@type': 'SearchAction',
          target: `${websiteUrl}search/{search_term_string}/`,
          'query-input': 'required name=search_term_string'
        }
      };
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content={SITE_TITLE} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={rssHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      hasGa && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
          <script is:inline>
            {`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaMeasurementId}');`}
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="site-shell">
        <a class="site-brand" href={homeHref}>{SITE_TITLE}</a>
        <form class="header-search" action={`${basePath}search/`} role="search">
          <input
            type="search"
            id="header-search-input"
            placeholder="검색..."
            autocomplete="off"
            aria-label="글 검색"
          />
          <button type="submit" aria-label="검색">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </form>
        <nav aria-label="주요 메뉴">
          <a href={homeHref}>홈</a>
          <a href={privacyHref}>개인정보처리방침</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="site-shell" id="main-content">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-shell">
        <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
        <a href={privacyHref}>개인정보처리방침</a>
      </div>
    </footer>
  </body>
</html>

<script define:vars={{ basePath }}>
  (() => {
    const form = document.querySelector('.header-search');
    const input = document.querySelector('#header-search-input');

    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) return;

    const getSearchQueryFromPath = () => {
      const m = window.location.pathname.match(/\/search\/(.+?)\/?$/);
      if (m) return decodeURIComponent(m[1]);
      const searchPath = `${basePath}search/`;
      if (!window.location.pathname.startsWith(searchPath)) return '';
      return new URLSearchParams(window.location.search).get('q') ?? '';
    };

    const toSearchPath = (value) => {
      const query = value.trim();
      return query ? `${basePath}search/${encodeURIComponent(query)}/` : basePath;
    };

    const initialQuery = getSearchQueryFromPath();
    if (initialQuery && !input.value) {
      input.value = initialQuery;
    }

    const syncSearchPath = () => {
      const nextPath = toSearchPath(input.value);
      const currentFull = window.location.pathname + window.location.search;
      if (currentFull !== nextPath) {
        window.history.replaceState(null, '', nextPath);
      }
      window.dispatchEvent(new CustomEvent('site-search-input', { detail: { query: input.value.trim() } }));
    };

    input.addEventListener('input', syncSearchPath);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.location.href = toSearchPath(input.value);
    });
  })();
</script>

<style>
  :root {
    --bg-canvas: #ffffff;
    --bg-surface: #f9f9f9;
    --bg-muted: #f0f0f0;
    --text-primary: #08102b;
    --text-secondary: #6c6f74;
    --text-tertiary: #aaaaaa;
    --text-inverse: #ffffff;
    --border-default: #e8eaf0;
    --border-strong: #08102b;
    --accent-primary: #482dff;
    --focus-ring: #482dff;
    --font-display: 'Noto Sans KR', 'Apple SD Gothic Neo', system-ui, sans-serif;
    --font-body: 'Noto Sans KR', 'Apple SD Gothic Neo', system-ui, sans-serif;
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: 1.25rem;
    --text-2xl: 1.75rem;
    --text-3xl: 2.5rem;
    --text-4xl: 3.5rem;
    --lh-tight: 1.1;
    --lh-base: 1.7;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --shadow-sm: 0 2px 8px rgba(8, 16, 43, 0.06);
    --shadow-md: 0 5px 35px rgba(8, 16, 43, 0.09);
    --shadow-lg: 0 10px 40px rgba(8, 16, 43, 0.12);
    --motion-fast: 150ms;
    --motion-base: 200ms;
    font-family: var(--font-body);
    line-height: var(--lh-base);
    color: var(--text-primary);
    background: var(--bg-canvas);
  }


  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg-canvas);
    color: var(--text-primary);
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -40px;
    background: var(--accent-primary);
    color: var(--text-inverse);
    padding: var(--space-2) var(--space-4);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 100;
    transition: top var(--motion-fast);
  }

  .skip-link:focus {
    top: var(--space-3);
  }

  .site-shell {
    max-width: 66rem;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .site-header {
    border-bottom: 1px solid var(--border-default);
    background: var(--bg-canvas);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header .site-shell {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-brand {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--accent-primary);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .header-search {
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 300px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--motion-fast);
  }

  .header-search:focus-within {
    border-color: var(--accent-primary);
  }

  .header-search input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 6px 12px;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--text-primary);
    outline: none;
    min-width: 0;
  }

  .header-search input::placeholder {
    color: var(--text-secondary);
  }

  .header-search button {
    border: none;
    background: transparent;
    padding: 6px 10px;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    transition: color var(--motion-fast);
  }

  .header-search button:hover {
    color: var(--accent-primary);
  }

  nav {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  nav a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-secondary);
    transition: color var(--motion-fast);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  nav a:hover {
    color: var(--accent-primary);
  }

  main {
    padding: var(--space-12) 0 var(--space-16);
  }

  .site-footer {
    border-top: 1px solid var(--border-default);
    padding: var(--space-8) 0;
  }

  .site-footer .site-shell {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }

  .site-footer p {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-footer a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--motion-fast);
  }

  .site-footer a:hover {
    color: var(--accent-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .site-shell {
      padding: 0 var(--space-4);
    }
  }
</style>
