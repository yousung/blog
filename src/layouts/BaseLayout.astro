---
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false
} = Astro.props as Props;

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteOrigin = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteOrigin);
const pageTitle = title === SITE_TITLE || title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
const withBasePath = (value: string) => {
  if (/^https?:\/\//.test(value)) return value;
  const normalized = value.startsWith('/') ? value.slice(1) : value;
  return `${basePath}${normalized}`;
};
const ogImage = new URL(withBasePath(image ?? '/og/site.svg'), siteOrigin);
const ogImageAlt = imageAlt ?? `${pageTitle} 대표 이미지`;
const socialTitle = type === 'article' ? title : pageTitle;
const imagePathname = ogImage.pathname.toLowerCase();
const ogImageType = imagePathname.endsWith('.png')
  ? 'image/png'
  : imagePathname.endsWith('.jpg') || imagePathname.endsWith('.jpeg')
    ? 'image/jpeg'
    : imagePathname.endsWith('.webp')
      ? 'image/webp'
      : imagePathname.endsWith('.gif')
        ? 'image/gif'
        : 'image/svg+xml';
const homeHref = basePath;
const privacyHref = `${basePath}privacy/`;
const categoriesHref = `${basePath}categories/`;
const tagsHref = `${basePath}tags/`;
const rssHref = new URL(withBasePath('/rss.xml'), siteOrigin).href;
const websiteUrl = new URL(basePath, siteOrigin).href;
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.href,
        inLanguage: 'ko-KR',
        isPartOf: {
          '@type': 'Blog',
          name: SITE_TITLE,
          url: websiteUrl
        },
        author: author ? { '@type': 'Person', name: author } : undefined,
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          url: websiteUrl
        },
        keywords: tags.length > 0 ? tags.join(', ') : undefined,
        datePublished: publishedTime,
        dateModified: modifiedTime ?? publishedTime,
        mainEntityOfPage: canonical.href,
        image: ogImage.href
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: websiteUrl,
        inLanguage: 'ko-KR',
        potentialAction: {
          '@type': 'SearchAction',
          target: `${websiteUrl}search/{search_term_string}/`,
          'query-input': 'required name=search_term_string'
        }
      };
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WXL65FXF');</script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R5MVZZDBHM"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R5MVZZDBHM');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content={SITE_TITLE} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={rssHref} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1322828698634218" crossorigin="anonymous"></script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXL65FXF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <aside class="sidebar" aria-label="사이드 메뉴">
      <nav class="sidebar-nav" aria-label="사이드바 메뉴">
        <a href={homeHref}>홈</a>
        <a href={categoriesHref}>카테고리</a>
        <a href={tagsHref}>태그</a>
      </nav>
    </aside>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="site-shell">
        <a class="site-brand" href={homeHref}>{SITE_TITLE}</a>
        <div class="header-actions">
          <nav class="desktop-nav" aria-label="주요 메뉴">
            <a href={homeHref}>홈</a>
            <a href={categoriesHref}>카테고리</a>
            <a href={tagsHref}>태그</a>
            <a href={privacyHref}>개인정보처리방침</a>
          </nav>
          <button class="search-toggle" aria-label="검색 열기" aria-expanded="false" aria-controls="search-overlay">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
          <button class="menu-toggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
            <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
        <div class="site-shell mobile-menu-inner">
          <nav class="mobile-nav" aria-label="모바일 메뉴">
            <a href={homeHref}>홈</a>
            <a href={categoriesHref}>카테고리</a>
            <a href={tagsHref}>태그</a>
            <a href={privacyHref}>개인정보처리방침</a>
          </nav>
        </div>
      </div>
    </header>

    <div class="search-overlay" id="search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="검색">
      <div class="search-overlay-backdrop"></div>
      <div class="search-overlay-panel">
        <form class="search-overlay-form" action={`${basePath}search/`} role="search">
          <svg class="search-overlay-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="overlay-search-input"
            name="q"
            placeholder="검색어를 입력하세요..."
            autocomplete="off"
            aria-label="글 검색"
          />
          <button type="button" class="search-overlay-close" aria-label="검색 닫기">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </form>
        <p class="search-overlay-hint">Enter 키로 검색</p>
      </div>
    </div>
    <main>
      <div class="site-shell" id="main-content">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <p class="footer-copy">© {new Date().getFullYear()} {SITE_TITLE}</p>
        <nav class="footer-links" aria-label="푸터 메뉴">
          <a href={homeHref}>홈</a>
          <a href={categoriesHref}>카테고리</a>
          <a href={tagsHref}>태그</a>
          <a href={privacyHref}>개인정보처리방침</a>
        </nav>
      </div>
    </footer>
    <script type="text/javascript" src="//wcs.pstatic.net/wcslog.js"></script>
    <script type="text/javascript">
      if(!wcs_add) var wcs_add = {};
      wcs_add["wa"] = "12f71a2fc18bd8";
      if(window.wcs) {
        wcs_do();
      }
    </script>
  </body>
</html>

<script define:vars={{ basePath }}>
  (() => {
    // Hamburger toggle
    const toggle = document.querySelector('.menu-toggle');
    const header = document.querySelector('.site-header');
    const mobileMenu = document.getElementById('mobile-menu');

    toggle?.addEventListener('click', () => {
      const isOpen = header.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? '메뉴 닫기' : '메뉴 열기');
      if (mobileMenu) mobileMenu.setAttribute('aria-hidden', String(!isOpen));
    });

    // Close menu on nav link click
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('menu-open');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', '메뉴 열기');
        if (mobileMenu) mobileMenu.setAttribute('aria-hidden', 'true');
      });
    });
  })();

  (() => {
    const overlay = document.getElementById('search-overlay');
    const overlayInput = document.getElementById('overlay-search-input');
    const searchToggle = document.querySelector('.search-toggle');
    const closeBtn = document.querySelector('.search-overlay-close');
    const backdrop = document.querySelector('.search-overlay-backdrop');

    const openSearch = () => {
      if (!overlay) return;
      overlay.classList.add('overlay-open');
      overlay.setAttribute('aria-hidden', 'false');
      searchToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => overlayInput?.focus(), 50);
    };

    const closeSearch = () => {
      if (!overlay) return;
      overlay.classList.remove('overlay-open');
      overlay.setAttribute('aria-hidden', 'true');
      searchToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    searchToggle?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', closeSearch);
    backdrop?.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSearch();
    });

    const overlayForm = overlay?.querySelector('form');
    overlayForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = overlayInput?.value.trim();
      if (query) {
        window.location.href = `${basePath}search/${encodeURIComponent(query)}/`;
      }
    });
  })();
</script>

<style>
  :root {
    --bg-canvas: #ffffff;
    --bg-surface: #f9f9f9;
    --bg-muted: #f0f0f0;
    --text-primary: #08102b;
    --text-secondary: #6c6f74;
    --text-tertiary: #aaaaaa;
    --text-inverse: #ffffff;
    --border-default: #e8eaf0;
    --border-strong: #08102b;
    --accent-primary: #482dff;
    --focus-ring: #482dff;
    --font-display: 'Pretendard Variable', 'Pretendard', -apple-system, 'Apple SD Gothic Neo', system-ui, sans-serif;
    --font-body: 'Pretendard Variable', 'Pretendard', -apple-system, 'Apple SD Gothic Neo', system-ui, sans-serif;
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: 1.25rem;
    --text-2xl: 1.75rem;
    --text-3xl: 2.5rem;
    --text-4xl: 3.5rem;
    --lh-tight: 1.2;
    --lh-base: 1.9;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --shadow-sm: 0 2px 8px rgba(8, 16, 43, 0.06);
    --shadow-md: 0 5px 35px rgba(8, 16, 43, 0.09);
    --shadow-lg: 0 10px 40px rgba(8, 16, 43, 0.12);
    --motion-fast: 150ms;
    --motion-base: 200ms;
    font-family: var(--font-body);
    line-height: var(--lh-base);
    color: var(--text-primary);
    background: var(--bg-canvas);
  }


  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg-canvas);
    color: var(--text-primary);
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -40px;
    background: var(--accent-primary);
    color: var(--text-inverse);
    padding: var(--space-2) var(--space-4);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 100;
    transition: top var(--motion-fast);
  }

  .skip-link:focus {
    top: var(--space-3);
  }

  .site-shell {
    max-width: 66rem;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .site-header {
    border-bottom: 1px solid var(--border-default);
    background: var(--bg-canvas);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header .site-shell {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-brand {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--accent-primary);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: var(--space-2);
    min-height: 44px;
    min-width: 44px;
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast);
  }

  .search-toggle:hover {
    color: var(--accent-primary);
  }

  /* Search overlay */
  .search-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  .search-overlay.overlay-open {
    display: block;
  }

  .search-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 16, 43, 0.45);
    backdrop-filter: blur(2px);
  }

  .search-overlay-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--bg-canvas);
    border-bottom: 1px solid var(--border-default);
    box-shadow: var(--shadow-lg);
    animation: slideDown 150ms ease;
  }

  @keyframes slideDown {
    from { transform: translateY(-8px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  .search-overlay-form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 66rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
  }

  .search-overlay-icon {
    flex-shrink: 0;
    color: var(--text-secondary);
  }

  .search-overlay-form input {
    flex: 1;
    border: none;
    background: transparent;
    font: inherit;
    font-size: var(--text-lg);
    color: var(--text-primary);
    outline: none;
    padding: var(--space-2) 0;
  }

  .search-overlay-form input::placeholder {
    color: var(--text-tertiary);
  }

  .search-overlay-close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast);
    min-width: 36px;
    min-height: 36px;
  }

  .search-overlay-close:hover {
    color: var(--text-primary);
  }

  .search-overlay-hint {
    text-align: center;
    margin: 0;
    padding: 0 var(--space-6) var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .desktop-nav {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .desktop-nav a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-secondary);
    transition: color var(--motion-fast);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .desktop-nav a:hover {
    color: var(--accent-primary);
  }

  /* Sidebar */
  .sidebar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 220px;
    border-right: 1px solid var(--border-default);
    background: var(--bg-canvas);
    overflow-y: auto;
    padding: var(--space-8) var(--space-6);
    z-index: 40;
  }

  .sidebar-brand {
    display: block;
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--accent-primary);
    margin-bottom: var(--space-8);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast), background var(--motion-fast);
  }

  .sidebar-nav a:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    padding: var(--space-2);
    min-height: 44px;
    min-width: 44px;
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast);
  }

  .menu-toggle:hover {
    color: var(--accent-primary);
  }

  .icon-close {
    display: none;
  }

  .site-header.menu-open .icon-menu {
    display: none;
  }

  .site-header.menu-open .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
    border-top: 1px solid var(--border-default);
    background: var(--bg-canvas);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .mobile-search {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--motion-fast);
  }

  .mobile-search:focus-within {
    border-color: var(--accent-primary);
  }

