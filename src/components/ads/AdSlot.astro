---
import { ADSENSE_CLIENT } from '../../consts';

interface Props {
  /** AdSense ad unit slot id */
  slot: string;
  /** display: responsive display unit, in-article: fluid in-article unit, multiplex: autorelaxed grid */
  variant: 'display' | 'in-article' | 'multiplex';
  /**
   * in-article only: move this ad block in front of the Nth <h2> inside `.article-body`
   * before the ad is requested. If the body has fewer headings, the ad stays where it was rendered.
   */
  beforeHeading?: number;
}

const { slot, variant, beforeHeading } = Astro.props;
const id = `ad-${slot}`;
---

<aside class={`ad-slot ad-slot--${variant}`} id={id} aria-label="광고">
  <span class="ad-slot__label">광고</span>
  {variant === 'display' && (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="false"
    ></ins>
  )}
  {variant === 'in-article' && (
    <ins
      class="adsbygoogle"
      style="display:block; text-align:center;"
      data-ad-layout="in-article"
      data-ad-format="fluid"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
    ></ins>
  )}
  {variant === 'multiplex' && (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-format="autorelaxed"
      data-matched-content-ui-type="image_stacked,image_stacked"
      data-matched-content-rows-num="3,2"
      data-matched-content-columns-num="2,4"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
    ></ins>
  )}
</aside>
<script is:inline define:vars={{ id, beforeHeading }}>
  (function () {
    var el = document.getElementById(id);
    if (!el) return;
    if (beforeHeading) {
      var headings = document.querySelectorAll('.article-body h2');
      var target = headings[beforeHeading - 1];
      if (target && target.parentNode) target.parentNode.insertBefore(el, target);
    }
    try {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } catch (e) {
      el.hidden = true;
    }
  })();
</script>

<style>
  .ad-slot {
    box-sizing: border-box;
    width: 100%;
    margin: var(--space-8) 0;
    padding: 0.6rem clamp(0.6rem, 2vw, 1rem) clamp(0.75rem, 2vw, 1rem);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    min-height: 120px;
  }

  .ad-slot__label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .ad-slot ins.adsbygoogle {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .ad-slot--multiplex {
    min-height: 300px;
  }

  .ad-slot ins.adsbygoogle[data-ad-status='unfilled'] {
    display: none !important;
  }

  .ad-slot:has(ins.adsbygoogle[data-ad-status='unfilled']) {
    display: none;
  }

  @media (max-width: 560px) {
    .ad-slot {
      margin: var(--space-6) 0;
      min-height: 280px;
    }

    .ad-slot--multiplex {
      min-height: 360px;
    }
  }
</style>
