---
import { ADSENSE_CLIENT } from '../../consts';

interface Props {
  /** AdSense ad unit slot id */
  slot: string;
  /** in-article: fluid in-article unit placed mid-body, multiplex: autorelaxed grid at the end */
  variant: 'in-article' | 'multiplex';
  /**
   * in-article only: render the ad only when `.article-body` has at least this many <h2>,
   * and place it in front of the middle <h2>. Shorter posts get no in-article ad.
   */
  minHeadings?: number;
}

const { slot, variant, minHeadings } = Astro.props;
const id = `ad-${slot}`;
---

<aside class={`ad-slot ad-slot--${variant}`} id={id} aria-label="광고" hidden={Boolean(minHeadings)}>
  <span class="ad-slot__label">광고</span>
  {variant === 'in-article' && (
    <ins
      class="adsbygoogle"
      style="display:block; text-align:center;"
      data-ad-layout="in-article"
      data-ad-format="fluid"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
    ></ins>
  )}
  {variant === 'multiplex' && (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-format="autorelaxed"
      data-matched-content-ui-type="image_stacked,image_stacked"
      data-matched-content-rows-num="3,2"
      data-matched-content-columns-num="2,4"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
    ></ins>
  )}
</aside>
<script is:inline define:vars={{ id, minHeadings }}>
  (function () {
    var el = document.getElementById(id);
    if (!el) return;
    if (minHeadings) {
      var headings = document.querySelectorAll('.article-body h2');
      var target = headings[Math.floor(headings.length / 2)];
      if (headings.length < minHeadings || !target || !target.parentNode) {
        el.remove();
        return;
      }
      target.parentNode.insertBefore(el, target);
      el.hidden = false;
    }
    try {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } catch (e) {
      el.hidden = true;
    }
  })();
</script>

<style>
  .ad-slot {
    box-sizing: border-box;
    width: 100%;
    margin: var(--space-8) 0;
    padding: 0.6rem clamp(0.6rem, 2vw, 1rem) clamp(0.75rem, 2vw, 1rem);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    min-height: 120px;
  }

  .ad-slot__label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .ad-slot ins.adsbygoogle {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .ad-slot--multiplex {
    min-height: 300px;
  }

  .ad-slot ins.adsbygoogle[data-ad-status='unfilled'] {
    display: none !important;
  }

  .ad-slot:has(ins.adsbygoogle[data-ad-status='unfilled']) {
    display: none;
  }

  @media (max-width: 560px) {
    .ad-slot {
      margin: var(--space-6) 0;
      min-height: 280px;
    }

    .ad-slot--multiplex {
      min-height: 360px;
    }
  }
</style>
