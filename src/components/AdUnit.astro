---
interface Props {
  slot?: string;
  format?: string;
  label?: string;
}

const {
  slot = import.meta.env.PUBLIC_ADSENSE_SLOT ?? '',
  format = 'auto',
  label = '광고',
} = Astro.props;

const client = 'ca-pub-1322828698634218';
const shouldRender = slot.length > 0;
---

{shouldRender && (
  <div class="ad-unit" aria-label={label}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}

<style>
  .ad-unit {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
</style>
