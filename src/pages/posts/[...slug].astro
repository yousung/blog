---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.status === 'published');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const defaultOgPath = `/og/${post.data.slug}.svg`;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={post.data.ogImage ?? defaultOgPath}
  imageAlt={`${post.data.title} 대표 이미지`}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  author={post.data.author}
  tags={post.data.tags}
>
  <article class="post">
    <p class="post-eyebrow">Article</p>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ko-KR')}</time>
    </p>
    <div class="tags-wrapper">
      <TagList tags={post.data.tags} basePath={basePath} />
    </div>
    <Content />
  </article>
  <GiscusComments />
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .post {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .post-eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .meta {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .tags-wrapper {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-default);
  }

  /* ─── Prose: paragraphs ─── */

  .post :global(p) {
    margin: 0 0 1.5em;
    overflow-wrap: anywhere;
    word-break: keep-all;
    line-height: 1.95;
    font-size: var(--text-lg);
    color: var(--text-primary);
    font-weight: 400;
  }

  /* ─── Headings ─── */

  .post :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    padding-bottom: 0.65em;
    border-bottom: 1px solid var(--border-default);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .post :global(h3) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .post :global(h4) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  /* ─── Lists ─── */

  .post :global(ul),
  .post :global(ol) {
    margin: 0 0 1.6em;
    padding-left: 0;
    list-style: none;
  }

  .post :global(ul > li) {
    position: relative;
    padding-left: 1.5em;
    margin-bottom: 0.6em;
    line-height: 1.9;
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .post :global(ul > li::before) {
    content: '';
    position: absolute;
    left: 0.3em;
    top: 0.73em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-primary);
    opacity: 0.8;
  }

  .post :global(ol) {
    counter-reset: ol-counter;
  }

  .post :global(ol > li) {
    counter-increment: ol-counter;
    position: relative;
    padding-left: 2em;
    margin-bottom: 0.6em;
    line-height: 1.9;
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .post :global(ol > li::before) {
    content: counter(ol-counter);
    position: absolute;
    left: 0;
    top: 0.05em;
    font-weight: 700;
    font-size: 0.8em;
    color: var(--accent-primary);
    background: rgba(72, 45, 255, 0.1);
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .post :global(li > ul),
  .post :global(li > ol) {
    margin-top: 0.5em;
    margin-bottom: 0.25em;
  }

  .post :global(li > ul > li::before) {
    width: 4px;
    height: 4px;
    background: none;
    border: 1.5px solid var(--accent-primary);
    opacity: 1;
  }

  /* ─── Blockquote ─── */

  .post :global(blockquote) {
    margin: 0 0 1.6em;
    padding: 1.1em 1.5em;
    border-left: 3px solid var(--accent-primary);
    background: rgba(72, 45, 255, 0.04);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.85;
  }

  .post :global(blockquote p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .post :global(blockquote p + p) {
    margin-top: 0.75em;
  }

  /* ─── Inline code ─── */

  .post :global(:not(pre) > code) {
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', 'Courier New', monospace;
    font-size: 0.875em;
    background: rgba(72, 45, 255, 0.07);
    color: #3520e0;
    padding: 0.18em 0.45em;
    border-radius: 4px;
    border: 1px solid rgba(72, 45, 255, 0.14);
    word-break: break-all;
  }

  /* ─── Code block ─── */

  .post :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 1.6em;
    padding: 1.25em 1.5em;
    border-radius: var(--radius-md);
    background: #f2f4fb;
    border: 1px solid var(--border-default);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  .post :global(pre code) {
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', 'Courier New', monospace;
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
    word-break: normal;
  }

  /* ─── Tables ─── */

  .post :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 2em;
    font-size: var(--text-base);
  }

  .post :global(thead) {
    background: var(--bg-muted);
  }

  .post :global(th) {
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    text-align: left;
    padding: 0.7em 1em;
    border-top: 1px solid var(--border-default);
    border-right: 1px solid var(--border-default);
    border-bottom: 2px solid var(--border-default);
    color: var(--text-primary);
    overflow-wrap: anywhere;
    word-break: keep-all;
    white-space: nowrap;
  }

  .post :global(th:first-child) {
    border-left: 1px solid var(--border-default);
  }

  .post :global(td) {
    padding: 0.65em 1em;
    border-right: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
    line-height: 1.65;
    font-size: var(--text-base);
    overflow-wrap: anywhere;
    word-break: keep-all;
    color: var(--text-primary);
    vertical-align: top;
  }

  .post :global(td:first-child) {
    border-left: 1px solid var(--border-default);
  }

  .post :global(tbody tr:nth-child(even)) {
    background: rgba(72, 45, 255, 0.025);
  }

  .post :global(tbody tr:hover) {
    background: rgba(72, 45, 255, 0.05);
    transition: background var(--motion-fast);
  }

  /* ─── Links ─── */

  .post :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(72, 45, 255, 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--motion-fast), text-decoration-color var(--motion-fast);
  }

  .post :global(a:hover) {
    color: var(--accent-primary);
    text-decoration-color: var(--accent-primary);
  }

  /* ─── HR ─── */

  .post :global(hr) {
    border: none;
    height: 1px;
    background: var(--border-default);
    margin: 2.5rem 0;
  }

  /* ─── Media ─── */

  .post :global(img),
  .post :global(video),
  .post :global(iframe) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .post :global(svg) {
    max-width: 100%;
    height: auto;
  }

  /* ─── Inline text ─── */

  .post :global(strong) {
    font-weight: 700;
  }

  .post :global(em) {
    font-style: italic;
    color: var(--text-secondary);
  }

  /* ─── Mobile ─── */

  @media (max-width: 640px) {
    .post {
      padding: var(--space-6);
    }

    .post :global(p),
    .post :global(ul > li),
    .post :global(ol > li) {
      font-size: var(--text-base);
      line-height: 1.85;
    }

    .post :global(blockquote) {
      font-size: var(--text-base);
      padding: 0.9em 1.1em;
    }
  }
</style>
