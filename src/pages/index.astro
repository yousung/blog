---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostFeed from '../components/PostFeed.astro';
import TagList from '../components/TagList.astro';
import { SITE_TITLE } from '../consts';
import { getAdSenseReadyPosts } from '../lib/posts';

const PAGE_SIZE = 10;
const posts = getAdSenseReadyPosts(await getCollection('posts'));
const [featured, ...rest] = posts;
const firstPagePosts = rest.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(rest.length / PAGE_SIZE));
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const postHref = (slug: string) => `${basePath}posts/${slug}/`;
const nextPageHref = totalPages > 1 ? `${basePath}page/2/` : null;
const initialCount = posts.length;
---

<BaseLayout title={SITE_TITLE}>
  <section class="home">
    <header class="home-intro">
      <p class="kicker">Latest Notes</p>
      <h1>{SITE_TITLE}</h1>
      <p class="intro-copy">개발, 생활, 경제, 건강에 관한 경험과 기록.</p>
    </header>
    <p class="search-meta" id="post-search-meta">전체 {initialCount}개 글</p>
    <div id="normal-feed">
      {featured && (
        <article class="featured-card">
          <a class="card-link" href={postHref(featured.data.slug)} aria-label={featured.data.title}></a>
          <div class="card-body">
            <p class="eyebrow">Featured</p>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.oneLineSummary ?? featured.data.summary}</p>
            <div class="featured-meta-row">
              <TagList tags={featured.data.tags} basePath={basePath} />
              <time datetime={featured.data.date.toISOString()}>{featured.data.date.toLocaleDateString('ko-KR')}</time>
            </div>
          </div>
        </article>
      )}
      {firstPagePosts.length > 0 && <p class="section-label" aria-hidden="true">최신 글</p>}
      <PostFeed posts={firstPagePosts} basePath={basePath} />
      {nextPageHref && (
        <nav class="pagination" aria-label="페이지 이동">
          <span class="pager-status">1 / {totalPages}</span>
          <a class="pager-link" href={nextPageHref}>다음</a>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: var(--space-8);
  }

  .home-intro {
    padding: clamp(1.5rem, 4vw, 2.75rem) 0 var(--space-6);
    border-bottom: 1px solid var(--border-default);
  }

  .kicker {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-3);
    max-width: 52rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--text-primary);
  }

  .intro-copy {
    margin: 0 0 var(--space-6);
    color: var(--text-secondary);
    max-width: 40rem;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  #normal-feed {
    display: grid;
    gap: var(--space-6);
  }

  .featured-card {
    position: relative;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-primary) 7%, transparent), transparent 38%),
      var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: box-shadow var(--motion-base), border-color var(--motion-base), transform var(--motion-base);
  }

  .featured-card:hover {
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent-primary) 30%, var(--border-default));
    transform: translateY(-2px);
  }

  .featured-card .card-link {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    z-index: 2;
  }

  .featured-card .card-body {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    pointer-events: none;
  }

  .featured-card :global(.tag-list a) {
    position: relative;
    z-index: 3;
    pointer-events: auto;
  }

  .featured-card :global(.tag-list) {
    margin: 0;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-card h2 {
    margin: 0 0 var(--space-3);
    max-width: 48rem;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: color var(--motion-fast);
  }

  .featured-card:hover h2 {
    color: var(--accent-primary);
  }

  .featured-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
    overflow-wrap: anywhere;
    word-break: break-word;
    max-width: 46rem;
  }

  .featured-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .featured-meta-row time {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .section-label::after {
    content: "";
    height: 1px;
    flex: 1;
    background: var(--border-default);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    border-top: 1px solid var(--border-default);
    padding-top: var(--space-6);
  }

  .pager-link {
    text-decoration: none;
    border: 1px solid var(--border-default);
    padding: var(--space-2) var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: 4px;
    transition: border-color var(--motion-fast), color var(--motion-fast);
  }

  .pager-link:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .pager-status {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .search-meta,
  .search-empty {
    margin: calc(-1 * var(--space-4)) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-empty {
    color: var(--accent-primary);
  }

  @media (max-width: 640px) {
    .home {
      gap: var(--space-6);
    }

    .home-intro {
      padding-top: var(--space-6);
    }

    .intro-copy {
      font-size: var(--text-base);
    }
  }
</style>
