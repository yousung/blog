---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
const homeHref = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<script is:inline>
  (function () {
    var m = window.location.pathname.match(/\/search\/(.+?)\/?$/);
    if (m) {
      try { sessionStorage.setItem('__search_q', decodeURIComponent(m[1])); } catch (_) {}
      window.location.replace('/search/');
    }
  })();
</script>

<BaseLayout title={`404 | ${SITE_TITLE}`} description="요청한 페이지를 찾을 수 없습니다." noindex={true}>
  <h1>404</h1>
  <p>요청한 페이지를 찾을 수 없습니다.</p>
  <p><a href={homeHref}>홈으로 돌아가기</a></p>
</BaseLayout>
