---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
const homeHref = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<script is:inline>
  (function () {
    const homeHref = `${window.location.origin}/`;
    const searchHref = `${window.location.origin}/search/`;
    if (
      window.location.pathname === '/entry' ||
      window.location.pathname === '/entry/' ||
      window.location.pathname === '/m/entry' ||
      window.location.pathname === '/m/entry/'
    ) {
      window.location.replace(homeHref);
      return;
    }
    const entryMatch = window.location.pathname.match(/^\/(?:m\/)?entry\/([^/]+)\/?$/);
    if (entryMatch) {
      try {
        const topic = decodeURIComponent(entryMatch[1]).replace(/-/g, ' ');
        if (topic) {
          window.location.replace(`${window.location.origin}/search/${encodeURIComponent(topic)}/`);
          return;
        }
      } catch (_) {}
    }
    const searchMatch = window.location.pathname.match(/^\/search\/(.+?)\/?$/);
    if (searchMatch) {
      try {
        sessionStorage.setItem('__search_q', decodeURIComponent(searchMatch[1]));
      } catch (_) {}
      window.location.replace(searchHref);
      return;
    }
    window.location.replace(homeHref);
  })();
</script>

<BaseLayout title={`404 | ${SITE_TITLE}`} description="요청한 페이지를 찾을 수 없습니다." noindex={true}>
  <h1>404</h1>
  <p>요청한 페이지를 찾을 수 없습니다.</p>
  <p><a href={homeHref}>홈으로 돌아가기</a></p>
</BaseLayout>
