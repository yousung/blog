---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostFeed from '../../components/PostFeed.astro';
import { SITE_TITLE } from '../../consts';
import { getAdSenseReadyPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const slugify = (tag: string) => tag.replace(/\//g, '-');
  const posts = getAdSenseReadyPosts(await getCollection('posts'));
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return allTags.map((tag) => ({ params: { tag: slugify(tag) }, props: { tag } }));
}

const tagSlug = (tag: string) => tag.replace(/\//g, '-');

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const posts = getAdSenseReadyPosts(await getCollection('posts'))
  .filter((e) => e.data.tags.includes(tag));
---

<BaseLayout title={`#${tag} | 태그 | ${SITE_TITLE}`} description={`'${tag}' 태그가 붙은 글 목록입니다.`}>
  <section class="tag-page">
    <header class="page-header">
      <p class="breadcrumb">
        <a href={`${basePath}tags/`}>태그</a>
        <span aria-hidden="true"> / </span>
        <span>#{tag}</span>
      </p>
      <h1>#{tag}</h1>
      <p class="page-meta">{posts.length}개 글</p>
    </header>
    <PostFeed posts={posts} basePath={basePath} />
  </section>
</BaseLayout>

<style>
  .tag-page {
    max-width: 48rem;
  }

  .page-header {
    padding: clamp(1.25rem, 3vw, 2rem) 0 var(--space-6);
    border-bottom: 1px solid var(--border-default);
    margin-bottom: var(--space-6);
  }

  .breadcrumb {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .page-header h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--lh-tight);
  }

  .page-meta {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>
