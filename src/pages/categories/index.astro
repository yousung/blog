---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const CATEGORY_MAP: Record<string, string> = {
  career: '생활',
  life: '건강',
  money: '경제',
  engineering: '기술',
  legacy: '기술',
};

const CATEGORY_DESC: Record<string, string> = {
  생활: '커리어, 일상, 경험에 관한 이야기',
  기술: '개발 실무, 기술 스택, 코드 관련 글',
};

const getDir = (post: CollectionEntry<'posts'>): string => {
  const fp = (post as any).filePath as string | undefined;
  if (fp) {
    const match = fp.match(/\/content\/posts\/([^/]+)\//);
    if (match?.[1]) return match[1];
  }
  return 'unknown';
};

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const posts = (await getCollection('posts')).filter((e) => e.data.status === 'published');

const categoryMap = posts.reduce<Record<string, number>>((acc, post) => {
  const cat = CATEGORY_MAP[getDir(post)] ?? getDir(post);
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {});

const categoryList = Object.entries(categoryMap)
  .map(([label, count]) => ({ label, desc: CATEGORY_DESC[label] ?? '', count }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title={`카테고리 | ${SITE_TITLE}`} description="카테고리별 글 목록을 확인하세요.">
  <section class="taxonomy-page">
    <header class="page-header">
      <h1>카테고리</h1>
      <p class="page-meta">{categoryList.length}개 카테고리 · 전체 {posts.length}개 글</p>
    </header>
    <ul class="category-list">
      {categoryList.map(({ label, desc, count }) => (
        <li>
          <a href={`${basePath}categories/${encodeURIComponent(label)}/`} class="category-card">
            <div class="category-info">
              <span class="category-label">{label}</span>
              {desc && <span class="category-desc">{desc}</span>}
            </div>
            <span class="category-count">{count}개</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .taxonomy-page {
    max-width: 48rem;
  }

  .page-header {
    padding: clamp(2rem, 6vw, 4rem) 0 var(--space-8);
    border-bottom: 1px solid var(--border-default);
    margin-bottom: var(--space-8);
  }

  .page-header h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--lh-tight);
  }

  .page-meta {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-fast), box-shadow var(--motion-fast), transform var(--motion-fast);
  }

  .category-card:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .category-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .category-label {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
  }

  .category-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .category-count {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-primary);
    white-space: nowrap;
  }
</style>
